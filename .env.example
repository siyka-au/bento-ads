# Connection settings for the example configs and integration tests.
# Copy to .env (gitignored) and fill in your PLC's details:
#
#   bento-ads -e .env -c example/config.yaml
#   go test -run Integration -v .
#
# Variables already set in the environment take precedence over this file.

# IP address of the PLC, or 127.0.0.1 for a runtime on this machine.
ADS_TARGET_IP=192.168.1.100

# AMS NetID of the target runtime.
ADS_TARGET_NET_ID=192.168.1.100.1.1

# ADS port of the PLC runtime: 851 for the first TwinCAT 3 PLC, 801 for TwinCAT 2.
ADS_TARGET_PORT=851

# true to connect through the local TwinCAT router (runtime on this machine,
# e.g. a usermode runtime). Leave false for a remote PLC.
ADS_LOCAL_MODE=false
